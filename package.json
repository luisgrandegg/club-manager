{
  "name": "club-manager",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate:sdk": "pnpm --filter @club-manager/api build:openapi && pnpm --filter @club-manager/sdk generate",
    "docs:architecture": "node scripts/update-architecture.mjs",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/update-architecture.mjs && git add docs/architecture.md"
  },
  "devDependencies": {
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
