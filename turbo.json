{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "openapi.json"]
    },
    "build:openapi": {
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["@club-manager/api#build:openapi"],
      "outputs": ["src/schema.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
